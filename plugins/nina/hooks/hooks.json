{
  "description": "Garde .env : refuse la lecture des fichiers de secrets. Plan : affiche le Project GitHub du repo en début de session. Harnais : signale en début de session un dépassement du budget d'instructions",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-env.sh\"",
            "statusMessage": "Vérification accès .env..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/plan.sh\"",
            "timeout": 15,
            "statusMessage": "Lecture du plan (Project GitHub)..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/harnais.sh\" --alerte",
            "timeout": 10,
            "statusMessage": "Mesure du harnais..."
          }
        ]
      }
    ]
  }
}
